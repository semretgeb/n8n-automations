        "schemaType": "manual",
        "inputSchema": "={\n  \"type\": \"object\",\n  \"properties\": {\n    \"vendor\": { \"type\": [\"string\", \"null\"] },\n    \"date\": { \"type\": [\"string\", \"null\"], \"description\": \"YYYY-MM-DD\" },\n    \"invoice_number\": { \"type\": [\"string\", \"null\"] },\n    \"currency\": { \"type\": [\"string\", \"null\"], \"description\": \"3-letter code, e.g. ETB, USD\" },\n    \"subtotal\": { \"type\": [\"number\", \"null\"] },\n    \"tax\": { \"type\": [\"number\", \"null\"] },\n    \"total\": { \"type\": [\"number\", \"null\"] },\n    \"category\": { \"type\": [\"string\", \"null\"], \"enum\": [\"food\", \"transport\", \"office\", \"utilities\", \"other\", null] }\n  },\n  \"required\": [\"vendor\", \"date\", \"invoice_number\", \"currency\", \"subtotal\", \"tax\", \"total\", \"category\"]\n}",
        "options": {
          "systemPromptTemplate": "You extract data from receipts and invoices. Use only values written in the document. If a field is not in the document, return null. Never guess or calculate a value that is not printed. Numbers without currency symbols or commas."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
