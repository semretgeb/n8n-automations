      "id": "51c987c6-82d8-469b-9970-710d207cf859",
      "name": "Tell me on Telegram",
      "webhookId": "8644cc7b-c63a-4432-923a-d9283a1cdb1c"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const biz = $('Keep ones with a website').item.json;\nconst html = typeof $json.html === 'string' ? $json.html : '';\nconst title = (html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i) || [])[1] || '';\nconst desc = (html.match(/<meta[^>]+name=[\"']description[\"'][^>]+content=[\"']([^\"']*)/i) || [])[1] || '';\nconst text = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;|&amp;|&#\\d+;/g, ' ')\n  .replace(/\\s+/g, ' ').trim();\nconst emails = [...new Set((html.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi) || [])\n  .filter(e => !/\\.(png|jpe?g|gif|webp|svg)$/i.test(e)))];\nconst ok = text.length > 200;\nreturn { json: {\n  ...biz,\n  email: biz.email || emails[0] || '',\n  site_ok: ok,\n  page: ok ? `${title}\\n${desc}\\n${text}`.slice(0, 3000) : '',\n}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "id": "a2dc9b94-3bef-4a68-872a-9be03fc66343",
      "name": "Clean page"
    },
    {
      "parameters": {
        "jsCode": "const { city, type, offer, max } = $('Build search').first().json;\nconst seen = new Set();\nconst out = [];\nfor (const el of $input.first().json.elements || []) {\n  const t = el.tags || {};\n  let site = t.website || t['contact:website'] || t.url;\n  if (!t.name || !site) continue;\n  if (!/^https?:\\/\\//i.test(site)) site = 'https://' + site;\n  const key = site.toLowerCase().replace(/^https?:\\/\\/(www\\.)?/, '').replace(/\\/$/, '');\n  if (seen.has(key)) continue;\n  seen.add(key);\n  out.push({ json: {\n    name: t.name,\n    website: site,\n    phone: t.phone || t['contact:phone'] || '',\n    email: t.email || t['contact:email'] || '',\n    address: [t['addr:street'], t['addr:city']].filter(Boolean).join(', '),\n    city, type, offer,\n  }});\n  if (out.length >= max) break;\n}\nif (!out.length) throw new Error(`No ${type} with a website found in ${city}. Try another type or city.`);\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "78e793dc-ff5c-4ee7-aadc-9f5f965bfd25",
      "name": "Keep ones with a website"
    },
    {
      "parameters": {
        "jsCode": "const tags = {\n  'Dentist': ['amenity=dentist', 'healthcare=dentist'],\n  'Clinic': ['amenity=clinic', 'amenity=doctors'],\n  'Restaurant': ['amenity=restaurant'],\n  'Cafe': ['amenity=cafe'],\n  'Hotel': ['tourism=hotel'],\n  'Gym': ['leisure=fitness_centre'],\n  'Beauty salon': ['shop=beauty', 'shop=hairdresser'],\n  'Real estate agency': ['office=estate_agent'],\n  'Lawyer': ['office=lawyer'],\n};\nconst f = $input.first().json;\nconst city = String(f['City']).trim().replace(/\"/g, '');\nconst type = f['Business type'];\nconst parts = tags[type].map(t => {\n  const [k, v] = t.split('=');\n  return `nwr[\"${k}\"=\"${v}\"][\"website\"](area.a);nwr[\"${k}\"=\"${v}\"][\"contact:website\"](area.a);`;\n}).join('');\nconst query = `[out:json][timeout:60];\n(area[\"name\"=\"${city}\"][\"boundary\"=\"administrative\"];\n area[\"name:en\"=\"${city}\"][\"boundary\"=\"administrative\"];)->.a;\n(${parts});\nout center tags 300;`;\nreturn [{ json: { query, city, type, offer: f['What you offer'], max: Number(f['Max leads'] || 20) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
