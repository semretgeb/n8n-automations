    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $('Clean page').item.json;\nconst ai = $json.output || {};\nreturn { json: {\n  Date: new Date().toISOString().slice(0, 10),\n  Business: b.name, Type: b.type, City: b.city,\n  Website: b.website, Phone: b.phone, Email: b.email, Address: b.address,\n  'What they do': ai.what_they_do || '',\n  'First line': ai.first_line || '',\n  Fit: ai.fit || 'unknown',\n  Status: b.site_ok && ai.first_line ? 'Ready to send' : 'Check manually',\n}};"
      },
