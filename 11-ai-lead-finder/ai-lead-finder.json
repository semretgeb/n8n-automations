    {
      "parameters": {
        "promptType": "define",
        "text": "=You help a freelancer write the first line of a cold email.\n\nThe freelancer offers: {{ $json.offer }}\nBusiness: {{ $json.name }} ({{ $json.type }} in {{ $json.city }})\nText from their website:\n\"\"\"\n{{ $json.page }}\n\"\"\"\n\nRules:\n- Use ONLY facts from the website text above. Never invent services, awards, years or names.\n- first_line: one friendly sentence, max 25 words, mentions something specific from their site, and links naturally to the offer. No \"I hope this finds you well\", no flattery.\n- what_they_do: max 12 words.\n- fit: \"high\" if the offer clearly helps this business, \"medium\" if maybe, \"low\" if not.\n- If the website text is empty or too short, set first_line to \"\", what_they_do to \"Website could not be read\" and fit to \"unknown\".\n- Write directly to the business using \"you\" and \"your\", not their name in third person.\n- Do not claim you already built something for them; suggest how the offer could help.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
