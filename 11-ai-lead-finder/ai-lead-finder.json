    {
      "parameters": {
        "jsCode": "const rows = $('Lead row').all().map(i => i.json);\nconst high = rows.filter(r => r.Fit === 'high');\nconst s = $('Keep ones with a website').first().json;\nlet msg = `🔎 Lead finder done: ${s.type} in ${s.city}\\n\\n`;\nmsg += `✅ ${rows.length} leads saved\\n🔥 ${high.length} high fit\\n`;\nmsg += `⚠️ ${rows.filter(r => r.Status === 'Check manually').length} websites could not be read\\n\\n`;\nmsg += high.slice(0, 5).map(r => `• ${r.Business}: ${r['First line']}`).join('\\n');\nreturn [{ json: { msg } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2144,
        0
      ],
      "id": "2ca86ae8-22d5-4509-a756-6aba20ef22fb",
      "name": "Count"
