{
  "name": "ai support agent -telegram",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "You are the customer assistant for a small shop in Addis Ababa. Customers may write in English, in Amharic, or in Amharic typed with English letters (for example \"Kefeyaw endet nw\" means \"How is payment?\"); reply in the language and script they use. Be brief and friendly. Write plain text only: no tables, no markdown, no | characters; for lists use one item per line. Before answering, use your tools to look up products or the FAQ, and answer only from what they return. If the answer is not there, say so, tell the customer a human will reply shortly, and end your message with the exact text [HANDOFF]. Never invent prices, stock or promises.For every question about products, prices, stock or shop details, call the tools again, even if the answer appeared earlier in this conversation; the data may have changed."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        224,
        0
      ],
      "id": "d20456e3-e3a3-49f5-92fb-ed8e656d281d",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-haiku-5-5",
          "mode": "list",
          "cachedResultName": "Claude Haiku 5.5"
        },
        "options": {
          "thinkingMode": "disabled"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
