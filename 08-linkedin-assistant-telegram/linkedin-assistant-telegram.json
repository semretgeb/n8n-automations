    {
      "parameters": {
        "jsCode": "function startPost(s) {\n  const day = new Date().toLocaleDateString('en-US', { weekday: 'long', timeZone: 'Africa/Addis_Ababa' });\n  const plan = {\n    Monday: ['Plan', 'What are you building or learning this week, and why does it matter for a small business?'],\n    Tuesday: ['Build log', 'What did you build today? What broke, and how did you fix it?'],\n    Wednesday: ['Tip', \"What's one tip from your work that a small business owner or builder could use today?\"],\n    Thursday: ['Build log', 'What did you build today? What broke, and how did you fix it?'],\n    Friday: ['Result', 'What did you finish this week, and what result did it get? (time saved, cost, a number)'],\n  };\n  const [type, question] = plan[day] || ['Build log', 'What did you build or learn recently? What broke, and how did you fix it?'];\n  s.stage = 'notes'; s.type = type; s.notes = ''; s.draft = '';\n  return { action: 'ask', type, question };\n}\nconst s = $getWorkflowStaticData('global');\nconst text = ($json.message?.text || '').trim();\nconst low = text.toLowerCase();\nconst say = (reply) => [{ json: { action: 'say', reply } }];\n\nif (!text) return say('Please send text messages only.');\nif (low === '/start' || low === '/help') {\n  return say('Hi! Every weekday at 4 pm I ask what you built and write a LinkedIn post from it.\\n\\n/post – start a post now\\nReply with changes to update a draft\\nedit: <your text> – use your own wording\\n✅ Approve – post it\\n⏭ Skip or /cancel – stop');\n}\nif (low === '/post' || low === '/new') return [{ json: startPost(s) }];\nif (low === '/cancel' || low === 'cancel' || low === 'skip' || low.includes('skip')) {\n  s.stage = 'idle';\n  return say('👍 OK, no post for now. Send /post any time to start one.');\n}\nif (s.stage === 'notes') {\n  s.notes = text;\n  return [{ json: { action: 'draft', type: s.type, notes: text, previous: '', feedback: '' } }];\n}\nif (s.stage === 'review') {\n  const approve = ['✅ approve', 'approve', 'approved', 'yes', 'ok', 'okay', 'post', 'post it', 'publish', '✅'];\n  if (approve.includes(low)) return [{ json: { action: 'post', text: s.draft, type: s.type, notes: s.notes } }];\n  if (low.startsWith('edit:')) {\n    s.draft = text.slice(5).trim();\n    return [{ json: { action: 'show', draft: s.draft } }];\n  }\n  return [{ json: { action: 'draft', type: s.type, notes: s.notes, previous: s.draft, feedback: text } }];\n}\nreturn say('Send /post to write a LinkedIn post now, or wait for my 4 pm question.');"
      },
