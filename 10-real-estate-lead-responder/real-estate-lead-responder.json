              "emailValue": "={{ $('Lead fields').item.json.email }}"
            },
            {
              "key": "Phone|phone_number",
              "phoneValue": "={{ $('Lead fields').item.json.phone }}"
            },
            {
              "key": "Message|rich_text",
              "textContent": "={{ $('Lead fields').item.json.message.slice(0, 1990) }}"
            },
            {
              "key": "AI summary|rich_text",
              "textContent": "={{ $('Qualify and reply').item.json.output.summary }}"
            },
            {
              "key": "Next step|rich_text",
              "textContent": "={{ $('Qualify and reply').item.json.output.next_step }}"
            },
            {
              "key": "Reply sent|rich_text",
              "textContent": "={{ $json.emailFailed ? '(email failed)' : $('Qualify and reply').item.json.output.email_body.slice(0, 1990) }}"
            },
            {
              "key": "Replied in (sec)|number",
              "numberValue": "={{ $json.seconds }}"
            },
            {
              "key": "Status|select",
              "selectValue": "New"
            },
            {
              "key": "Received|date",
              "date": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.notion",
      "typeVersion": 3,
      "position": [
        1240,
        0
      ],
      "name": "Save in CRM",
      "onError": "continueRegularOutput",
      "id": "d1e2f3a4-0000-4000-8000-000000000008"
    },
